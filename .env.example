# =============================================================================
# ENVIRONMENT — copy to `.env.local` and fill in. Never commit the filled copy.
#
# Every key below is read by name somewhere in `src/`. A missing key is not a
# crash: the feature that needs it reports "not configured" in the UI and the
# rest of the app carries on. The comment on each line says what stops working.
#
# Vercel note: `.env` and `.env.local` are gitignored and therefore NOT
# deployed. Anything you want in production has to be set in the Vercel project
# settings as well — the SERP, stock-image and credential-encryption keys are
# the ones people most often forget.
# =============================================================================

# ---- Database ---------------------------------------------------------------
# Postgres connection string. Required — nothing works without it.
DATABASE_URL=

# ---- Auth (Clerk) -----------------------------------------------------------
# Required for sign-in. The publishable key is safe in the browser; the secret
# key is not and must stay server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ---- App URL ----------------------------------------------------------------
# Used to build absolute links and OAuth redirect URIs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Publishing credentials (article writer) --------------------------------
# 32-byte key, base64 or hex, for AES-256-GCM. This encrypts the WordPress
# application passwords, Shopify admin tokens and custom-site webhook secrets
# that publishing targets store. Without it `encryptSecret` returns null and the
# app refuses to save a credential rather than writing it in plain text — so
# "Connect" will fail with an explicit message until this is set.
#   generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Shopify Admin API version the publisher targets, e.g. 2026-01. Shopify retires
# versions on a schedule; bump this rather than editing code. Defaults to a
# known-good version when unset.
SHOPIFY_API_VERSION=

# ---- Search data (SERP) -----------------------------------------------------
# Serper.dev key. Drives "what already ranks", the trending-topic ideas built
# from People-also-ask, and the competitor length/heading averages. Without it
# the article still generates; the research panels say the SERP is unavailable.
# SERPER_DEV_API_KEY is accepted as an alias for the same key.
SERPER_API_KEY=
SERPER_DEV_API_KEY=

# ---- Stock media ------------------------------------------------------------
# Pixabay key for the media studio's stock tab. The fallback is tried when the
# primary is rate-limited. Without either, only upload and AI generation work.
PIXABAY_API_KEY=
PIXABAY_API_KEY_FALLBACK=

# ---- Google AI (Vertex / Gemini) -------------------------------------------
# The article generator, image models and every agent run on these. Use either a
# service-account JSON path (local) or the inlined credential fields (Vercel).
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PROJECT_ID=
# Direct Gemini API key, used where a Vertex call is not available.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ---- Model overrides (optional) ---------------------------------------------
# Every model id is configurable so a deprecated model can be swapped without a
# deploy of code. Leave blank to use the defaults in `src/lib/agents/llm.ts`.
VERTEX_DEFAULT_PRO_MODEL=
VERTEX_DEFAULT_FAST_MODEL=
MODEL_ORCHESTRATOR=
MODEL_CONTENT_CREATOR=
MODEL_TREND_RESEARCHER=
MODEL_COMPETITOR_ANALYST=
MODEL_CEO_AUDITOR=
MODEL_CHAT_UTILITY=
MODEL_EMBEDDING=
MODEL_IMAGE_GENERATOR=
MODEL_VIDEO_GENERATOR=
MODEL_SLIDE_REGENERATOR=
IMAGE_FALLBACK_MODELS=
NEXT_PUBLIC_MODEL_CHAT_CONTROLLER=
NEXT_PUBLIC_MODEL_IMAGE_GENERATOR=
NEXT_PUBLIC_MODEL_VIDEO_GENERATOR=

# ---- Storage (Supabase) -----------------------------------------------------
# Where generated and uploaded media is hosted. Without it, images stay as data
# URLs, which are too large to publish to a CMS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_URL=
NEXT_PUBLIC_SUPABASE_PROJECT_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# ---- Rate limiting (optional) ----------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
REDIS_TOKEN=

# ---- Social platform OAuth (optional per platform) -------------------------
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_SANDBOX_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---- Billing — Lemon Squeezy ------------------------------------------------
# Merchant of record, so they hold the card, charge the tax and own the
# chargeback. Leave these empty and the app runs on the Free plan with every
# checkout button visibly disabled — nothing half-works.
#
# API key: Settings → API in the Lemon Squeezy dashboard.
LEMONSQUEEZY_API_KEY=
# Store id: the number in Settings → Stores (not the subdomain).
LEMONSQUEEZY_STORE_ID=
# Webhook signing secret: Settings → Webhooks. The webhook is the ONLY writer of
# plan state, so a wrong secret here means payments never reach the account.
LEMONSQUEEZY_WEBHOOK_SECRET=
# "true" while pointing at the test store. Test payments are labelled everywhere
# they appear so a test charge is never mistaken for revenue.
LEMONSQUEEZY_TEST_MODE=true

# Variant ids — one buyable thing each, copied from the dashboard. They differ
# between the test and live stores, which is exactly why they are configuration.
# Any that are missing disable their own button and are listed on the billing tab.
LEMONSQUEEZY_VARIANT_TRIAL=
LEMONSQUEEZY_VARIANT_GO_MONTHLY=
LEMONSQUEEZY_VARIANT_GO_YEARLY=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_AGENCY_MONTHLY=
LEMONSQUEEZY_VARIANT_AGENCY_YEARLY=
LEMONSQUEEZY_VARIANT_TOPUP_1000=
LEMONSQUEEZY_VARIANT_TOPUP_5000=
LEMONSQUEEZY_VARIANT_TOPUP_15000=

# ---- Trial abuse guard ------------------------------------------------------
# Salt for the one-way hashes of email, IP and device signature the $1 trial
# checks itself against. Set it once and never rotate it in place: a new salt
# makes every stored hash unmatchable, which reopens the trial to everyone who
# already used it. Any long random string.
TRIAL_HASH_SALT=

# IP intelligence, all optional and all independent. Each one that is set adds a
# signal (VPN, proxy, Tor, datacenter, mobile relay) to the trial's risk score;
# with none of them set the guard still works from email, device and ASN reuse.
# The lookups fail open — an outage at a provider must never block a paying
# customer — so a missing key costs accuracy, never availability.
IPQUALITYSCORE_KEY=
VPNAPI_IO_KEY=
PROXYCHECK_IO_KEY=
IPAPI_IS_KEY=

# ---- Scheduled jobs ---------------------------------------------------------
# Shared secret the cron routes check before doing any work.
CRON_SECRET=

# ---- Affiliate program ------------------------------------------------------
# Who may open /dashboard/admin/payouts and pay affiliates by hand. Clerk user
# ids or email addresses, comma-separated. With this unset nobody is an admin:
# the page stays closed and payout requests simply wait.
#   AFFILIATE_ADMINS="user_2abc…,ops@example.com"
AFFILIATE_ADMINS=
# Payout account details are stored encrypted; this is the same key WordPress
# credentials use, listed above (APP_ENCRYPTION_KEY). Without it, payout
# requests are refused with a clear message rather than stored in the clear.

