generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  name             String?
  avatar           String?
  stripeCustomerId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  workspaces       Workspace[]

  // ── Billing (see the BILLING section at the end of this file) ─────────────
  // A subscription and a credit wallet belong to the person, not to a
  // workspace: someone on Pro with three workspaces draws all three from one
  // balance, so the plan cannot be sidestepped by making another workspace.
  subscription   Subscription?
  creditWallet   CreditWallet?
  creditLedger   CreditLedger[]
  usageEvents    UsageEvent[]
  featureUsage   FeatureUsage[]
  trialClaims    TrialClaim[]
  billingEvents  BillingEvent[]

  // ── Affiliate program (see the AFFILIATE section at the end of this file) ─
  /// Generated lazily on the user's first visit to the Affiliate tab, so
  /// existing rows need no backfill and nobody carries a code they never asked
  /// for.
  referralCode   String?      @unique
  referralsMade  Referral[]   @relation("ReferralReferrer")
  referral       Referral?    @relation("ReferralReferred")
  commissions    Commission[]
  payouts        Payout[]

  // ── Administration (see the ADMIN section at the end of this file) ────────
  /// ADMIN rows open the back office. The env allowlist (ADMIN_USERS) is the
  /// bootstrap that makes the first admin; every later one is granted here.
  role          UserRole  @default(USER)
  /// Set while the account is suspended. Every gate in the product refuses a
  /// blocked account, and the dashboard shows the reason instead of the app.
  blockedAt     DateTime?
  blockedReason String?
  blockedBy     String?
  /// Free-text notes only admins see.
  adminNotes    String?   @db.Text
  /// Refreshed at most once an hour from the dashboard layout, for "active users".
  lastSeenAt    DateTime?

  notifications UserNotification[]
  chatFeedback  ChatFeedback[]
  errorEvents   ErrorEvent[]
}

model Workspace {
  id              String            @id @default(uuid())
  name            String
  industry        String?
  website         String?
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  brandDNA        BrandDNA?
  socialAccounts  SocialAccount[]
  competitors     Competitor[]
  chatSessions    ChatSession[]
  automationRules AutomationRule[]
  contentPosts    ContentPost[]
  posts           Post[]
  mediaAssets     MediaAsset[]
  hashtagGroups   HashtagGroup[]
  memories        Memory[]
  chatSettings    ChatSettings?
  growthGoal      GrowthGoal?
  wordpressSite   WordPressSite?
  connections     UserConnection[]
  mcpServers      McpServerConnection[]
  trackedLinks    TrackedLink[]
  linkClicks      LinkClick[]
  leadEvents      LeadEvent[]
  publishLogs     PublishLog[]
  articleRuns     ArticleRun[]
  publications    PublishResult[]
  performance     PerformanceData[]
  optimizations   OptimizationRun[]
  platformInsights PlatformInsight[]

  // Website lead-capture tag (one site per workspace)
  trackingKey        String?   @unique
  trackingDomain     String?
  trackingVerifiedAt DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
}

model BrandDNA {
  id             String    @id @default(uuid())
  tone           String?
  missionVision  String?
  targetAudience String?
  primaryColors  String[]
  forbiddenWords String[]
  writingStyle   String?
  workspaceId    String    @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId])
}

// The six networks the product can actually connect, publish to and preview.
// Kept in step with `PlatformId` in src/lib/capabilities/platformCapabilities.ts —
// a value here that has no capability entry, OAuth config and publisher is a
// platform a user can select and never publish to.
enum Platform {
  INSTAGRAM
  LINKEDIN
  FACEBOOK
  YOUTUBE
  TIKTOK
  PINTEREST
}

model SocialAccount {
  id             String    @id @default(uuid())
  platform       Platform
  accessToken    String    @default("")
  refreshToken   String?
  accountId      String    @default("")
  handle         String    @default("")
  pageName       String?
  avatarUrl      String?
  tokenExpiresAt DateTime?
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, platform])
  @@index([workspaceId])
}

model Competitor {
  id          String    @id @default(uuid())
  name        String
  platform    Platform
  profileUrl  String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

/**
 * Latest platform-insights snapshot per (workspace, platform). Written by the
 * insights sync (cron + lazy dashboard refresh). Only numbers the platform API
 * actually reported are stored — the row is created with state="unavailable"
 * and a message instead of guessing.
 */
model PlatformInsight {
  id             String    @id @default(uuid())
  workspaceId    String
  platform       String
  state          String    @default("unavailable")
  message        String?
  fetchedAt      DateTime
  followers      Int?
  impressions30d Int?
  views30d       Int?
  likes30d       Int?
  comments30d    Int?
  shares30d      Int?
  engagementRate Float?
  workspace      Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, platform])
  @@index([workspaceId])
}

model ChatSession {
  id          String    @id @default(uuid())
  title       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  messages    Message[]
  /// Model id the session last ran on, so reopening it restores the same brain.
  model       String?
  pinned      Boolean   @default(false)
  archived    Boolean   @default(false)
  /// Rolling LLM-written summary of everything older than the live window, so a
  /// long session never loses its earlier context when history is truncated.
  summary     String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, archived, updatedAt])
}

enum Role {
  USER
  AGENT
}

model Message {
  id            String      @id @default(uuid())
  role          Role
  content       String      @db.Text
  toolCalls     Json?
  /// Live thought-summary transcript captured from the model while it worked.
  reasoning     String?     @db.Text
  /// User attachments for a USER message: [{ name, type, size, kind, url? }]
  attachments   Json?
  /// Structured results the UI renders as cards: generated media, deep links
  /// into other tabs, published receipts, files. [{ kind, ... }]
  artifacts     Json?
  /// Follow-up prompts offered under an AGENT message.
  suggestions   Json?
  model         String?
  durationMs    Int?
  /// "ok" | "error" | "cancelled"
  finishReason  String?
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([chatSessionId])
  @@index([chatSessionId, createdAt])
}

model Memory {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  category    String    @default("general")
  content     String    @db.Text
  /// 1 (trivia) … 5 (never forget). Pinned + high-importance facts are always
  /// injected into the controller's context regardless of semantic similarity.
  importance  Int       @default(3)
  /// User-pinned facts survive every prune and always load.
  pinned      Boolean   @default(false)
  /// "auto" (extracted from a conversation) | "user" (explicitly told to remember)
  source      String    @default("auto")
  /// Chat session the fact was learned in, for provenance in the memory browser.
  sessionId   String?
  /// Bumped every time the fact is recalled, so hot memories rank higher.
  hitCount    Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([category])
  @@index([workspaceId, pinned])
}

/// Everything the Automate/Chat controller lets a user tune, per workspace.
/// One row per workspace, created lazily on first read.
model ChatSettings {
  id          String    @id @default(uuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // --- Brain ---
  model            String  @default("gemini-3.1-pro-preview")
  temperature      Float   @default(0.4)
  maxToolLoops     Int     @default(8)
  /// "off" | "concise" | "balanced" | "deep"
  thinkingLevel    String  @default("balanced")
  /// "live" | "collapsed" | "hidden" — how thought summaries are displayed.
  thinkingDisplay  String  @default("live")
  streamTokens     Boolean @default(true)

  // --- Voice ---
  /// "auto" | "english" | "roman-urdu" | "urdu"
  replyLanguage    String  @default("auto")
  /// "executive" | "detailed" | "concise"
  replyStyle       String  @default("executive")
  /// Extra always-on instructions the user writes for the controller.
  customInstructions String? @db.Text

  // --- Autonomy ---
  /// "auto" runs write actions immediately; "confirm" asks first for
  /// publish/delete/push-class actions.
  autonomy         String  @default("auto")
  allowWebSearch   Boolean @default(true)
  allowMediaGen    Boolean @default(true)
  allowPublishing  Boolean @default(true)
  allowPlugins     Boolean @default(true)

  // --- Memory ---
  memoryEnabled    Boolean @default(true)
  memoryAutoSave   Boolean @default(true)
  memoryRecallTopK Int     @default(8)

  // --- Surface ---
  /// "all" | "compact" | "failures" — how much of the tool timeline shows.
  toolVisibility   String  @default("all")
  /// Auto-navigate to the target tab when the controller produces a deep link.
  autoOpenLinks    Boolean @default(false)
  showSuggestions  Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

enum Frequency {
  DAILY
  WEEKLY
  CUSTOM
}

model AutomationRule {
  id                String        @id @default(uuid())
  promptContext     String        @db.Text
  frequency         Frequency
  scheduledTime     String
  platformOverrides String[]
  isActive          Boolean       @default(true)
  workspaceId       String
  workspace         Workspace     @relation(fields: [workspaceId], references: [id])
  contentPosts      ContentPost[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([workspaceId])
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  REJECTED
}

model ContentPost {
  id               String          @id @default(uuid())
  title            String
  body             String          @db.Text
  imageUrl         String?
  videoUrl         String?
  platform         Platform
  status           PostStatus      @default(DRAFT)
  scheduledFor     DateTime?
  publishedAt      DateTime?
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id])
  automationRuleId String?
  automationRule   AutomationRule? @relation(fields: [automationRuleId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId])
  @@index([automationRuleId])
}

model Post {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  platform       String
  content        String    @db.Text
  imageUrl       String?
  imagePrompt    String?   @db.Text
  format         String?
  hashtags       String[]
  mediaType      String?
  mediaSource    String?
  source         String?
  status         String    @default("PENDING_APPROVAL")
  publishError   String?   @db.Text
  agentLogs      Json?
  campaignTopic  String?
  campaignHook   String?
  captionHistory Json?
  mediaHistory   Json?
  publishedAt    DateTime?
  scheduledFor   DateTime?
  settings       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId])
}

model MediaAsset {
  id          String    @id @default(uuid())
  url         String
  filename    String
  contentType String?
  size        Int?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model HashtagGroup {
  id          String    @id @default(uuid())
  name        String
  tags        String[]
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model GrowthGoal {
  id                   String       @id @default(uuid())
  workspaceId          String       @unique
  workspace            Workspace    @relation(fields: [workspaceId], references: [id])
  leadTarget           Int
  leadType             String       @default("QUALIFIED_LEADS")
  customLeadTypeName   String?
  timeframeDays        Int
  startDate            DateTime     @default(now())
  targetPlatforms      String[]     @default([])
  pausedPlatforms      String[]     @default([])

  // Where leads are expected from: "SOCIAL" and/or "WEBSITE"
  leadSources          String[]     @default(["SOCIAL"])
  // Per-platform real CTA destinations, e.g. { "default": "https://…", "linkedin": "https://…" }
  ctaDestinations      Json?
  dailyPostCap         Int?
  articlesPerWeek      Int?
  // Minutes an autopilot post waits before going live, so the user can still delete it
  graceMinutes         Int          @default(15)
  lastPlanRunAt        DateTime?
  lastPlanError        String?      @db.Text

  status               String       @default("INSUFFICIENT_DATA")
  statusReason         String?      @db.Text
  autopilotMode        String       @default("AUTOPILOT")
  autopilotPermissions Json?
  isAutopilotPaused    Boolean      @default(false)
  isPublishingPaused   Boolean      @default(false)
  strategy             Json?
  decisions            Json?
  experiments          Json?
  metricSnapshots      Json?
  lastAuditedAt        DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// LEAD MEASUREMENT — real, measured data only
// ---------------------------------------------------------------------------

/// One short link per AI-generated post/article CTA. Clicks that arrive through
/// it are real clicks from social media, not estimates.
model TrackedLink {
  id          String      @id @default(uuid())
  code        String      @unique
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  postId      String?
  goalId      String?
  channel     String      @default("SOCIAL")
  platform    String
  destination String
  pillar      String?
  clickCount  Int         @default(0)
  leadCount   Int         @default(0)
  clicks      LinkClick[]
  leads       LeadEvent[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([workspaceId])
  @@index([postId])
}

model LinkClick {
  id            String      @id @default(uuid())
  trackedLinkId String
  trackedLink   TrackedLink @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id])
  platform      String
  referrer      String?
  country       String?
  device        String?
  /// sha256(ip + salt) — used only to flag repeat clicks, no raw IP stored
  ipHash        String?
  isUnique      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([trackedLinkId])
  @@index([workspaceId, createdAt])
}

model LeadEvent {
  id            String       @id @default(uuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  trackedLinkId String?
  trackedLink   TrackedLink? @relation(fields: [trackedLinkId], references: [id])
  postId        String?
  platform      String?
  /// MANUAL | WEBSITE_TAG | LINK_CLICK_CONFIRMED
  source        String       @default("MANUAL")
  /// SOCIAL | WEBSITE
  channel       String       @default("SOCIAL")
  /// form_submit | whatsapp | mailto | tel | custom
  action        String?
  leadType      String       @default("QUALIFIED_LEADS")
  contactName   String?
  contactInfo   String?
  value         Float?
  note          String?      @db.Text
  /// NEW | CONFIRMED | QUALIFIED | WON | LOST
  status        String       @default("CONFIRMED")
  occurredAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([workspaceId, occurredAt])
  @@index([postId])
}

/// Slim permanent publish receipt. Heavy Post rows are purged after 3 days but
/// this row (and its live link) is kept, so history never disappears.
model PublishLog {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  postId        String?
  goalId        String?
  trackedLinkId String?
  /// SOCIAL | WEBSITE
  channel       String    @default("SOCIAL")
  platform      String
  format        String?
  /// PUBLISHED | FAILED
  status        String
  liveUrl       String?
  mediaUrl      String?
  mediaType     String?
  excerpt       String    @db.VarChar(240)
  topic         String?
  keyword       String?
  error         String?   @db.Text
  publishedAt   DateTime  @default(now())

  @@index([workspaceId, publishedAt])
  @@index([postId])
}

model WordPressSite {
  id                String    @id @default(uuid())
  workspaceId       String    @unique
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  siteUrl           String
  username          String
  /// Encrypted when APP_ENCRYPTION_KEY is set. Never returned to the client.
  appPassword       String
  defaultStatus     String    @default("publish")
  defaultCategoryId Int?
  defaultAuthorId   Int?
  postType          String    @default("posts")
  enableYoastSeo    Boolean   @default(true)
  lastVerifiedAt    DateTime?
  lastError         String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
}

// Generic external connector credentials (GitHub, HeyGen, Canva, MCP servers,
// ...). Credentials are stored as an encrypted JSON blob (APP_ENCRYPTION_KEY)
// and never sent to the browser — reads only report `hasCredentials`.
model UserConnection {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  providerKey    String
  authType       String    @default("api_key")
  /// Encrypted JSON credentials map. Never returned to the client.
  credentials    String?   @db.Text
  accountLabel   String?
  status         String    @default("pending")
  lastVerifiedAt DateTime?
  lastError      String?   @db.Text
  meta           Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, providerKey])
  @@index([workspaceId])
}

// User-added external MCP (Model Context Protocol) servers. The URL plus any
// auth headers are stored (headers encrypted with APP_ENCRYPTION_KEY) and the
// discovered tool list is cached so chat requests stay fast. Connections are
// opened per request (serverless-friendly Streamable HTTP).
model McpServerConnection {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  name           String
  url            String
  /// Encrypted JSON header map when APP_ENCRYPTION_KEY is set.
  headers        String?   @db.Text
  enabled        Boolean   @default(true)
  /// Snapshot of tools discovered at the last successful verify:
  /// { tools: [{ name, description, inputSchema }], discoveredAt }
  toolCache      Json?
  lastVerifiedAt DateTime?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ===========================================================================
// ARTICLE PIPELINE
//
// One article is one ArticleRun advanced a stage at a time, because the platform
// kills a function at 300s and twenty-three stages do not fit in one request.
// Each stage is its own row: what it produced, how long it took, and — when it
// failed — the named reason. The screen reads these rows, so it can only ever
// show work that actually happened.
// ===========================================================================

model ArticleRun {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  /// quick (12 stages) | deep (23). Chosen per run, never derived from the plan.
  mode        String    @default("quick")
  /// idle | running | blocked | done | failed
  status      String    @default("idle")
  /// The stage key from src/lib/article/stages.ts that runs next.
  currentStage String   @default("business")

  /// The brief: keyword, title, market, language, length, toggles.
  brief       Json
  /// Inputs accumulated by earlier stages and read by later ones.
  state       Json?
  /// quality, differentiation, trust, relevance. Absent until `score` runs.
  scores      Json?

  /// Set when a stage blocks the run (evidence gate, publish gate).
  blockedBy    String?
  /// The blocker's own words. Never a generic "SEO failed".
  blockedReason String? @db.Text

  startedAt      DateTime?
  stageStartedAt DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stages   ArticleStage[]
  sources  ResearchSource[]
  claims   EvidenceClaim[]
  publications PublishResult[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

model ArticleStage {
  id     String     @id @default(uuid())
  runId  String
  run    ArticleRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Stage key from src/lib/article/stages.ts.
  stage  String
  /// Its 1-based position in this run's list, so the UI can order without a join.
  order  Int
  /// pending | running | done | blocked | failed | skipped
  status String     @default("pending")

  /// What the stage produced. The shape is the stage's contract in the plan.
  artifact Json?
  /// Why it failed or blocked, in the words the user should read.
  error    String?  @db.Text
  /// Model calls this stage spent, for the cost the user is shown.
  modelCalls Int    @default(0)
  durationMs Int?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([runId, stage])
  @@index([runId, order])
}

// A source the research stage found. Kept as a row because a claim's provenance
// has to survive the run: months later the question is "where did this come
// from", and a JSON blob inside an artifact cannot answer it.
model ResearchSource {
  id     String     @id @default(uuid())
  runId  String
  run    ArticleRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  url       String  @db.Text
  title     String? @db.Text
  publisher String?
  /// The date the source itself carries, not the date we fetched it.
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  /// The passage the claim rests on, quoted, so a human can check it.
  excerpt     String?   @db.Text
  /// primary | official | journalism | vendor | forum | unknown
  sourceType  String    @default("unknown")
  /// 200-level fetch, or the reason it could not be read.
  reachable   Boolean   @default(false)
  fetchError  String?   @db.Text

  claims EvidenceClaim[]

  @@index([runId])
}

// One factual claim the article wants to make, and the five checks it has to
// pass. `status` is what the writer reads: a blocked claim is never handed to it.
model EvidenceClaim {
  id       String          @id @default(uuid())
  runId    String
  run      ArticleRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId String?
  source   ResearchSource? @relation(fields: [sourceId], references: [id])

  /// The claim as the article would state it.
  claim  String @db.Text
  /// statistic | fact | quote | recommendation | business_fact
  kind   String @default("fact")

  /// The five checks, each true only when it was actually performed and passed.
  sourceExists   Boolean @default(false)
  sourceReachable Boolean @default(false)
  /// The source says this, not merely something adjacent to it.
  sourceSupports Boolean @default(false)
  /// Recent enough for a claim of this kind.
  current        Boolean @default(false)
  trustworthy    Boolean @default(false)

  /// allowed | blocked
  status  String  @default("blocked")
  /// Which check failed, in words: "the 2019 figure is too old to state as current".
  reason  String? @db.Text
  /// Where the claim ended up in the draft, once the writer used it.
  usedIn  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId, status])
  @@index([sourceId])
}

// ===========================================================================
// AFTER PUBLISHING: SEARCH CONSOLE AND THE OPTIMISATION LOOP
//
// Most tools stop at "published". These three tables are what happens next:
// the URL an article became, what Search Console says that URL is being found
// for, and the proposals that come out of the gap between the two.
//
// Nothing here touches a live page. An optimisation is a row a person reads and
// approves; the draft it produces goes back through the editor and the fact
// check before anybody publishes it again.
// ===========================================================================

// One published article at one URL. The row the whole phase hangs off, because
// Search Console reports per page and this is the only place that records which
// page an article became.
model PublishResult {
  id          String      @id @default(uuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  /// The run that produced it, when a run did. Kept nullable so deleting a run's
  /// history does not erase the fact that a page is live.
  runId       String?
  run         ArticleRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  /// The UserConnection id of the CMS target, and which platform it was.
  targetId    String?
  providerKey String?
  /// Scheme + host + path only, lowercased host, no query and no fragment — the
  /// same normalisation Search Console reports pages under, so the two join.
  url         String   @db.VarChar(512)
  /// The platform's own id for the post, so a later update goes to the same one.
  remoteId    String?
  title       String   @db.Text
  /// The keyword it was written for. A query that is *not* this is the signal the
  /// optimisation loop looks for.
  keyword     String?
  /// publish | draft | pending, as the platform accepted it.
  status      String   @default("publish")

  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  optimizations OptimizationRun[]

  @@unique([workspaceId, url])
  @@index([workspaceId, publishedAt])
  @@index([runId])
}

// One day of Search Console data for one query on one page. Rows rather than a
// blob because the question that matters is "which query started sending
// traffic, and when" — that is a sort, not a scan of JSON.
//
// Joined to PublishResult by URL rather than by a foreign key: the data is worth
// keeping for a page we did not publish, and worth keeping after a publication
// row is gone.
model PerformanceData {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  /// The page as Search Console reports it, normalised the same way as above.
  page  String   @db.VarChar(512)
  /// What a person actually typed into Google.
  query String   @db.VarChar(300)
  date  DateTime @db.Date

  impressions Int   @default(0)
  clicks      Int   @default(0)
  /// As Search Console reports them — a 0..1 ratio and an average position, not
  /// recomputed here, so this screen cannot disagree with the console itself.
  ctr      Float @default(0)
  position Float @default(0)

  fetchedAt DateTime @default(now())

  @@unique([workspaceId, page, query, date])
  @@index([workspaceId, page, date])
  @@index([workspaceId, date])
}

// A proposal to update a published article, raised because it is being found for
// something it does not answer. `status` never reaches "applied" on its own:
// applying is a person pressing a button, and this row records that it was.
model OptimizationRun {
  id            String        @id @default(uuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  publicationId String
  publication   PublishResult @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  /// proposed | verified | applied | dismissed | failed
  status String @default("proposed")

  /// The queries that raised it, with their numbers as of that day, so a proposal
  /// read a month later still says what it was reacting to.
  triggers Json
  /// What it proposes: sections to add or passages to change, each with the
  /// queries it answers. Guarded before it is stored, like every artifact.
  proposal Json?
  /// The run that carried research and the evidence gate for this proposal — the
  /// same two stages the first draft passed, so an added section's ledger is as
  /// openable as the article's.
  verifyRunId String?
  /// Why it was dismissed, or why verification refused it. Its own words.
  note String? @db.Text

  raisedAt   DateTime  @default(now())
  verifiedAt DateTime?
  appliedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([publicationId, raisedAt])
}

// ===========================================================================
// SYSTEM NOTICES — THE ONE THING IN THE APP THAT IS NOT PER WORKSPACE
//
// Everything else a user sees is scoped to a workspace. This is not: it is what
// the people running the product say to everyone — maintenance windows, a
// platform API that changed under us, a feature that is live.
//
// Deliberately standalone. No relation to User or Workspace, because a notice is
// not owned by an account and must not disappear when one is deleted, and
// because "read" is a timestamp the browser keeps rather than a row per user per
// notice.
// ===========================================================================

model SystemNotice {
  id String @id @default(uuid())

  /// info | success | warning | error — the same four tones the bell already
  /// renders, so a notice needs no special icon path.
  tone  String  @default("info")
  title String  @db.VarChar(200)
  body  String? @db.Text

  /// Optional "read more": an internal path or an absolute URL. The bell decides
  /// which by looking at the value, exactly as it does for workspace alerts.
  href      String? @db.VarChar(512)
  linkLabel String? @db.VarChar(80)

  /// ALL for now. The column exists so a future targeted broadcast — one plan,
  /// one region — does not need a schema change to land.
  audience String @default("ALL")

  /// Off by default: a notice is written, read back, then published. Unpublishing
  /// is how a notice is retracted, so nothing is ever deleted to hide it.
  published Boolean @default(false)

  /// The window it is shown in. A null endsAt means "until it is unpublished",
  /// which is the right default for anything that is not a maintenance slot.
  startsAt DateTime  @default(now())
  endsAt   DateTime?

  /// Clerk user id of whoever published it. Accountability, not authorisation —
  /// who may publish is decided by the allowlist, not by this column.
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, startsAt])
}



// ═══════════════════════════════════════════════════════════════════════════
// BILLING
//
// Everything a paid plan needs, and nothing that pretends to be one. The old
// arrangement kept the plan as a JSON blob in `Memory` and inferred credit use
// by counting Post rows, which meant two things: the plan could not be trusted,
// and model spend that produced no row was invisible. Both are fixed here.
//
// Five tables carry the whole system:
//
//   Subscription  — what the person is entitled to, mirrored from Lemon Squeezy
//   CreditWallet  — what they have left to spend
//   CreditLedger  — every movement of credits, append-only, idempotent
//   UsageEvent    — every model call that cost money, in real micro-dollars
//   FeatureUsage  — per-period counters for the caps credits alone cannot express
//
// Plus two guards: TrialClaim (one trial per person, not per signup) and
// BillingEvent (the raw webhook log, so a replay cannot double-grant).
//
// The unit: 1 credit = $0.01 of list model spend. UsageEvent.costMicros is the
// measured truth; CreditLedger is what the customer was charged for it. They are
// kept separate on purpose — the first tells us whether a plan is priced right,
// the second is what the customer can audit.
// ═══════════════════════════════════════════════════════════════════════════

enum PlanTier {
  FREE
  TRIAL
  GO
  PRO
  AGENCY
}

enum SubscriptionStatus {
  /// No paid subscription has ever existed, or it ended and was not replaced.
  NONE
  /// Inside the 3-day trial window. Entitlements are the trial's, not Go's.
  TRIALING
  /// Paid and current.
  ACTIVE
  /// A renewal failed and Lemon Squeezy is retrying. Access is kept — the
  /// customer has not chosen to leave, a card expired.
  PAST_DUE
  /// Recovery ran out of retries. Access drops to Free.
  UNPAID
  /// Cancelled but still inside the paid period; ends at `endsAt`.
  CANCELLED
  /// The period is over. Access is Free.
  EXPIRED
  /// Paused by the customer through the portal.
  PAUSED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

/// The person's plan, mirrored from Lemon Squeezy. Nothing in the product reads
/// Lemon Squeezy directly on a request path — the webhook writes here and the
/// app reads here, so entitlement checks stay fast and work when LS is down.
model Subscription {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   PlanTier           @default(FREE)
  status SubscriptionStatus @default(NONE)
  cycle  BillingCycle       @default(MONTHLY)

  // ── Lemon Squeezy identity ───────────────────────────────────────────────
  /// LS customer id. Survives plan changes, so it is how a returning customer is
  /// recognised at checkout instead of creating a second customer record.
  lsCustomerId     String?
  /// LS subscription id. Null on Free and on a trial that has no LS record yet.
  lsSubscriptionId String? @unique
  lsOrderId        String?
  lsProductId      String?
  lsVariantId      String?
  /// Which variant the plan came from, kept as text so a variant rename in the
  /// LS dashboard cannot orphan a live subscription.
  lsVariantName    String?

  // ── Period ───────────────────────────────────────────────────────────────
  /// Start of the current billing period. The credit grant is keyed to this, so
  /// a renewal that arrives twice cannot grant twice.
  periodStart DateTime @default(now())
  periodEnd   DateTime
  /// Set while status is TRIALING. Read directly rather than inferred from the
  /// plan, because a trial can be extended without changing the plan.
  trialEndsAt DateTime?
  renewsAt    DateTime?
  /// When a cancelled subscription actually loses access.
  endsAt      DateTime?
  /// True once the customer has cancelled but before `endsAt` passes. The UI
  /// says "ends on 12 March" rather than "cancelled", which is the truth.
  cancelAtPeriodEnd Boolean @default(false)

  // ── Payment instrument, for display only ─────────────────────────────────
  cardBrand    String?
  cardLastFour String?
  /// "card" | "paypal" | ... — LS reports card fields as null for PayPal, so the
  /// method is stored explicitly instead of being guessed from a missing brand.
  paymentMethod String?

  // ── Portal links (LS pre-signs these; each is valid 24h from issue) ───────
  portalUrl              String?
  updatePaymentMethodUrl String?
  portalUrlsFetchedAt    DateTime?

  /// True when the subscription came from an LS test-mode store. A test-mode
  /// subscription never grants live entitlements in production.
  testMode Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plan, status])
  @@index([lsCustomerId])
  @@index([periodEnd])
}

/// What is left to spend. One wallet per person; every workspace they own draws
/// from it.
///
/// Two balances, because they expire differently: the monthly grant is use-it-or-
/// lose-it (it is what the subscription paid for this period) and a top-up is
/// bought outright and never expires. Debits take the grant first, so a top-up
/// is not silently burned before the thing the customer already paid for.
model CreditWallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// This period's plan grant, decremented as it is spent.
  grantBalance Int @default(0)
  /// Purchased credits. Never reset.
  topUpBalance Int @default(0)

  /// What the plan grants each period, so a renewal can reset without reading
  /// the plan catalogue inside a transaction.
  monthlyGrant Int @default(0)

  /// The period this grant belongs to. A renewal for a period that already
  /// granted is a no-op, which is what makes webhook replay safe.
  grantPeriodStart DateTime @default(now())
  grantPeriodEnd   DateTime

  /// Running totals, for the usage panel and for pricing post-mortems.
  lifetimeGranted Int @default(0)
  lifetimeSpent   Int @default(0)

  /// Credits held for an in-flight run (a deep article, a video) so two parallel
  /// requests cannot both spend the last of the balance. Released on completion
  /// or by the sweeper if the run dies.
  heldCredits Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger CreditLedger[]
  holds  CreditHold[]
}

enum LedgerKind {
  /// Plan grant at the start of a period.
  GRANT
  /// Purchased top-up.
  TOPUP
  /// Spent on an action.
  DEBIT
  /// Returned because the action failed after the debit.
  REFUND
  /// Manual adjustment by an operator. Always carries a note.
  ADJUSTMENT
  /// Unused grant removed at period end.
  EXPIRY
}

/// Append-only. Every credit that moves leaves a row, and the row records the
/// balance it produced — so the wallet can be re-derived from the ledger if the
/// two ever disagree, and the customer can be shown exactly what was charged.
model CreditLedger {
  id       String       @id @default(uuid())
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId String
  wallet   CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  kind LedgerKind
  /// Positive for GRANT/TOPUP/REFUND, negative for DEBIT/EXPIRY.
  credits Int

  /// The action catalogue key this was charged for — "ai.post.campaign",
  /// "media.video", "article.deep", "chat.message". Free text on purpose: a new
  /// action must not require a migration before it can be metered.
  action String?
  /// Which workspace the spend happened in. Null for account-level movements.
  workspaceId String?

  /// What the credits bought, for the customer's own audit trail: a post id, an
  /// ArticleRun id, a chat message id.
  referenceType String?
  referenceId   String?

  /// The wallet total after this row was written (grant + top-up).
  balanceAfter Int

  /// Measured list cost of the work this row paid for, in micro-dollars. Written
  /// after the fact from the UsageEvents the action produced. Lets us see which
  /// action prices are wrong without re-reading provider bills.
  costMicros Int?

  /// Makes a retry safe. Two requests carrying the same key produce one row.
  idempotencyKey String? @unique

  note String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([action])
}

/// A reservation taken before an expensive run starts.
///
/// Without this, two tabs both starting a deep article when 400 credits remain
/// would both pass the balance check and both run. The hold is taken in the same
/// transaction as the check, converted to a DEBIT on success, and released on
/// failure. `expiresAt` exists because a process that dies mid-run cannot release
/// its own hold.
model CreditHold {
  id       String       @id @default(uuid())
  walletId String
  wallet   CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  credits     Int
  action      String
  workspaceId String?
  referenceId String?

  /// Swept and released after this passes. Sized to the longest a run can take.
  expiresAt DateTime
  /// Set when the hold became a debit or was released, so the sweeper skips it.
  settledAt DateTime?

  createdAt DateTime @default(now())

  @@index([walletId, settledAt])
  @@index([expiresAt, settledAt])
}

/// One row per model call that cost money. Written by the provider itself, not by
/// the feature that called it, which is the point: a new code path cannot spend
/// without appearing here, because it cannot reach a model without going through
/// the provider.
///
/// This is the answer to "no user may use AI without our knowledge". Credits are
/// what the customer is charged; this is what it actually cost.
model UsageEvent {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Null for account-level work (a website scan during onboarding).
  workspaceId String?

  /// The product surface that caused the call — "ai-studio", "chat", "article",
  /// "goals", "schedule", "brand-dna". Set from the async context the request
  /// established, so it is right even for a call five frames deep.
  feature String @default("unknown")
  /// The action key, when the call belongs to a billed action.
  action  String?

  /// Resolved model id, exactly as sent to Vertex.
  model String
  /// "text" | "json" | "grounded" | "vision" | "stream" | "image" | "video" | "embed"
  callKind String

  inputTokens    Int @default(0)
  outputTokens   Int @default(0)
  /// Billed as output by Gemini 3.x, tracked separately so a thinking-heavy
  /// prompt is visible as such rather than as a large answer.
  thinkingTokens Int @default(0)
  cachedTokens   Int @default(0)
  /// Google Search grounding requests this call issued. Billed per request on top
  /// of tokens, and one call can issue several.
  groundingRequests Int @default(0)
  /// Images returned, for image models priced per image.
  imageCount     Int @default(0)
  /// Seconds of video returned, for video models priced per second.
  videoSeconds   Float @default(0)

  /// Measured list cost in micro-dollars (1_000_000 = $1). Integer on purpose:
  /// floats accumulate error over millions of rows and this feeds pricing.
  costMicros Int @default(0)

  latencyMs Int?
  /// False when the call errored. A failed call that still consumed input tokens
  /// is still billed by Google, so it is still recorded.
  ok        Boolean @default(true)
  errorKind String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([model, createdAt])
  @@index([feature, createdAt])
  @@index([createdAt])
}

/// Counters for the limits credits cannot express.
///
/// Credits stop a user spending more money than they bought. They do not stop a
/// Go customer running twelve deep articles, because Go is not sold with deep
/// articles at any credit balance. Anything shaped "at most N of X per period"
/// lives here: videos, articles by mode, active goals, autopilot cycles, uses of
/// the best-time scheduler on Free.
model FeatureUsage {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Catalogue key of the capped feature — "media.video", "article.quick",
  /// "article.deep", "schedule.bestTime", "goal.autopilotCycle".
  feature String

  /// The billing period this count belongs to, so the reset is the subscription's
  /// own boundary and not a calendar month.
  periodStart DateTime
  periodEnd   DateTime

  used Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, feature, periodStart])
  @@index([userId, periodStart])
}

enum TrialDecision {
  /// The trial was granted.
  ALLOWED
  /// Refused: something about this attempt matched a trial already taken.
  BLOCKED
  /// Granted, but the attempt scored high enough to be worth looking at.
  FLAGGED
}

/// One trial per person, enforced on the evidence available rather than on the
/// email address alone.
///
/// A row is written for every *attempt*, allowed or not, because the blocked
/// attempts are the data: they are how we learn a range is being farmed, and how
/// a wrongly-blocked customer can be found and let in. Raw IPs are never stored —
/// only a salted hash — which is enough to recognise a repeat without holding
/// personal data we have no reason to hold.
///
/// Signals, in the order they carry weight:
///   fingerprintHash — the strongest, hardest to change casually
///   ipHash          — defeated by a VPN, which is why the VPN flags exist
///   emailHash       — normalised (dots and +tags stripped) so aliases collapse
///   asn / isVpn …   — a datacenter IP during signup is itself the signal
model TrialClaim {
  id     String  @id @default(uuid())
  /// Null when the attempt was refused before an account existed.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// sha256(normalised email + salt).
  emailHash String
  /// sha256(ip + salt). Same construction as LinkClick.ipHash.
  ipHash    String
  /// sha256 of the client-side signal bundle (canvas, fonts, timezone, screen,
  /// hardware concurrency). Absent when the client refused to produce one, which
  /// is itself scored.
  fingerprintHash String?

  /// Geo and network context, from the IP-intelligence lookup. Kept for the
  /// scoring rule and for reviewing a block, not for targeting.
  ipCountry String?
  ipRegion  String?
  asn       String?
  asnOrg    String?

  isVpn        Boolean @default(false)
  isProxy      Boolean @default(false)
  isTor        Boolean @default(false)
  isDatacenter Boolean @default(false)
  isRelay      Boolean @default(false)
  /// True when the email domain is a known disposable-mail provider.
  isDisposableEmail Boolean @default(false)

  /// 0–100. The rule that produced the decision, so a threshold change can be
  /// evaluated against attempts that already happened.
  riskScore Int    @default(0)
  /// Which signals fired, as a list of short codes, for the operator view.
  riskFlags String[]

  decision TrialDecision
  /// Why, in a sentence the support inbox can quote back to a customer.
  reason   String?

  /// The claim this attempt collided with, when it was blocked as a repeat.
  collidedWithId String?

  /// LS ids, when the trial reached checkout.
  lsCustomerId     String?
  lsSubscriptionId String?

  createdAt DateTime @default(now())

  @@index([emailHash])
  @@index([ipHash])
  @@index([fingerprintHash])
  @@index([decision, createdAt])
  @@index([userId])
}

/// The raw webhook log.
///
/// Written before anything is acted on and keyed by the id Lemon Squeezy sends,
/// so a redelivery — which LS does on any non-2xx, and which an operator can
/// trigger by hand from the dashboard — finds the row already there and grants
/// nothing twice. `payload` is kept whole because a billing dispute is settled by
/// what the provider actually sent, not by what we parsed out of it.
model BillingEvent {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// LS event id from the X-Event-Id header, falling back to a hash of the body
  /// when the header is absent. Unique — this column is the replay guard.
  eventId String @unique
  /// "subscription_created", "subscription_payment_success", "order_created", …
  eventName String

  lsCustomerId     String?
  lsSubscriptionId String?
  lsOrderId        String?

  /// What it moved the account to, when the event changed the plan.
  plan   PlanTier?
  status SubscriptionStatus?

  /// Amount in cents, as LS reported it, and the currency it settled in.
  amountCents Int?
  currency    String?

  /// The whole verified payload.
  payload Json

  /// False until the handler finished. A row that stays false is a webhook we
  /// accepted and failed to apply — the thing worth alerting on.
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?

  testMode Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventName, createdAt])
  @@index([processed])
  @@index([lsSubscriptionId])
}

// ═══════════════════════════════════════════════════════════════════════════
// AFFILIATE PROGRAM
//
// A referral is earned, not claimed. The chain of custody runs:
//
//   1. A visitor arrives with ?ref=CODE. Middleware drops a 30-day cookie.
//   2. When that person's User row is born (onboarding), the cookie is read and
//      a Referral row links them to the code's owner — after the fraud checks
//      below. Most attempts die here, and the row says why.
//   3. When their FIRST paid plan goes live, the billing webhook converts the
//      referral and mints a Commission — locked for 30 days so a refund or
//      chargeback kills it before it ever becomes money.
//   4. After the lock the commission is available as either platform credits
//      (added to the existing CreditWallet) or a cash payout. Cash is requested
//      against saved account details and paid by hand: an admin sees the
//      request, transfers through JazzCash / Easypaisa / PayPal themselves, and
//      marks it paid. No money moves automatically.
//
// Fraud posture (deliberately strict): a signup arriving through a VPN, proxy,
// Tor, a relay or a datacenter IP is rejected outright, as is a disposable
// email, a self-referral, or a device/IP that matches the referrer's own.
// Only salted hashes are stored — never a raw IP, email or fingerprint.
// ═══════════════════════════════════════════════════════════════════════════

enum ReferralStatus {
  /// Signed up through the link; nothing earned yet.
  PENDING
  /// First paid plan went live; a Commission exists.
  CONVERTED
  /// Blocked by the fraud checks, or the qualifying payment was refunded.
  REJECTED
}

enum CommissionStatus {
  /// Earned but inside the 30-day refund window.
  LOCKED
  /// The window passed; can become credits or a payout.
  AVAILABLE
  /// Spent — attached to a payout or converted to wallet credits.
  CASHED_OUT
  /// Refund or fraud clawback.
  REJECTED
}

enum PayoutMethod {
  JAZZCASH
  EASYPAISA
  PAYPAL
}

enum PayoutStatus {
  /// Requested by the user; waiting for an admin.
  REQUESTED
  /// Acknowledged by an admin; transfer in progress.
  APPROVED
  /// The admin completed the manual transfer.
  PAID
  /// Refused. The commissions return to AVAILABLE.
  REJECTED
}

/// One referred account. `referredId` is unique: a person can only ever be
/// attributed once, to the first code they arrived with.
model Referral {
  id         String @id @default(uuid())
  referrerId String
  referrer   User   @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String @unique
  referred   User   @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)

  status       ReferralStatus @default(PENDING)
  /// Why a referral was rejected, in words the affiliate page can show.
  rejectReason String?

  // ── Signup-time fraud signals (salted hashes only) ────────────────────────
  /// Same construction as TrialClaim.ipHash, so the two can be compared.
  signupIpHash  String?
  /// sha256 of UA + accept-language, the device signal available without a
  /// client-side fingerprint bundle.
  signupUaHash  String?
  ipCountry     String?
  asn           String?

  isVpn        Boolean @default(false)
  isProxy      Boolean @default(false)
  isTor        Boolean @default(false)
  isDatacenter Boolean @default(false)
  isRelay      Boolean @default(false)

  /// 0–100, the rule that produced the decision.
  riskScore Int     @default(0)
  /// Short codes for the signals that fired, for the operator view.
  riskFlags String[]

  // ── Conversion ────────────────────────────────────────────────────────────
  convertedAt      DateTime?
  /// PlanTier of the first paid plan, e.g. "PRO".
  planPurchased    String?
  firstPaymentCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commission Commission?

  @@index([referrerId, createdAt])
  @@index([signupIpHash])
}

/// The money a referral earned. Born LOCKED; the 30-day window exists because
/// Lemon Squeezy refunds arrive inside it and a commission must die before it
/// is paid out, not after.
model Commission {
  id         String @id @default(uuid())
  referralId String @unique
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referrerId String
  referrer   User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  /// What the affiliate earns, in USD cents.
  amountCents Int
  /// The first payment it was calculated from, for the audit trail.
  basisCents  Int

  status       CommissionStatus @default(LOCKED)
  /// When LOCKED becomes AVAILABLE.
  unlocksAt    DateTime

  /// Set when this commission became part of a payout request.
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  /// True when the affiliate chose credits over cash.
  convertedToCredits Boolean @default(false)
  rejectReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, status])
  @@index([status, unlocksAt])
}

/// A cash withdrawal the user asked for and an admin pays by hand. The account
/// details are encrypted at rest (APP_ENCRYPTION_KEY) and only ever decrypted
/// on the admin screen; everywhere else the masked form is shown.
model Payout {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amountCents Int

  method PayoutMethod
  /// Account holder name as it appears with the provider.
  accountName   String
  /// Encrypted: JazzCash/Easypaisa mobile number, or PayPal email.
  accountDetail String
  /// What the user and the affiliate page may see: 03••••••21 / j•••@gmail.com
  accountMasked String

  status PayoutStatus @default(REQUESTED)

  /// The admin's own transaction reference for the manual transfer.
  reference    String?
  adminNote    String?
  reviewedBy   String?
  reviewedAt   DateTime?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions Commission[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// ADMINISTRATION
//
// The back office. Everything here exists so the people running the product can
// change how it behaves without a deploy: who is an admin, which models run and
// what they cost, which third-party keys are live, what a plan is allowed to do,
// and what has gone wrong. Nothing below is read by a customer-facing screen
// except UserNotification (their inbox) and ChatFeedback (their own votes).
//
// Two rules hold across every table:
//
//   Secrets are encrypted at rest with APP_ENCRYPTION_KEY and only ever shown
//   masked. The admin screen can rotate a key; it cannot read one back.
//   Every mutation an admin makes leaves an AdminAuditLog row. The row is the
//   answer to "who changed the Pro grant to 9,000 credits and when".
// ═══════════════════════════════════════════════════════════════════════════

enum UserRole {
  USER
  ADMIN
}

/// One row per setting, keyed by a dotted name ("ai.model.CONTENT_CREATOR",
/// "billing.plan.PRO.monthlyCredits", "keys.SERPER_API_KEY"). The value is JSON
/// so a setting can be a string, a number, a list or an object without a schema
/// change per setting. `secret` rows hold an encrypted string and are returned
/// masked from every read path.
model AppSetting {
  key       String   @id
  value     Json
  secret    Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Models an admin added or edited from the dashboard. Rows here are merged over
/// the code-defined rate card and chat picker: a row whose id matches a built-in
/// model overrides it, a new id becomes a new option. `enabledForChat` puts it in
/// the chat dropdown; `chatCredits` is what one turn on it costs, so an expensive
/// custom model can be priced honestly instead of at the flat rate.
model AiModel {
  id               String    @id
  label            String
  blurb            String?
  provider         String    @default("vertex")
  /// "text" | "image" | "video" | "embed"
  kind             String    @default("text")
  inputPerMTok     Float     @default(0)
  outputPerMTok    Float     @default(0)
  cachedPerMTok    Float?
  perImage         Float?
  perVideoSecond   Float?
  supportsThinking Boolean   @default(true)
  supportsTools    Boolean   @default(true)
  supportsVision   Boolean   @default(true)
  /// "frontier" | "fast" | "legacy"
  tier             String    @default("frontier")
  enabledForChat   Boolean   @default(false)
  /// Credits charged per chat turn on this model. Null = the catalogue's flat price.
  chatCredits      Int?
  /// Cheapest plan that may pick this model in chat. Null = any plan with chat.
  minPlan          PlanTier?
  isDefaultChat    Boolean   @default(false)
  sortOrder        Int       @default(100)
  archived         Boolean   @default(false)
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([enabledForChat, archived])
}

/// A message from the product to one person. Unlike SystemNotice — which is a
/// broadcast with browser-side read state — this is addressed and its read state
/// is a column, so an admin can see whether the person it was sent to saw it.
model UserNotification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// info | success | warning | error
  tone      String  @default("info")
  title     String  @db.VarChar(200)
  body      String? @db.Text
  href      String? @db.VarChar(512)
  linkLabel String? @db.VarChar(80)

  /// Clerk id of the admin who sent it; null for system-generated rows.
  sentBy String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
}

/// A thumbs up or down on one assistant message, with an optional note. Unique
/// per (message, user) so a vote can be changed but never counted twice.
model ChatFeedback {
  id          String @id @default(uuid())
  messageId   String
  sessionId   String
  workspaceId String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1 = helpful, -1 = not helpful.
  rating  Int
  comment String? @db.Text
  /// Snapshots so the admin view survives the message being deleted.
  model          String?
  messageExcerpt String? @db.VarChar(600)

  /// Admin triage: null = new, else "reviewed" | "actioned" | "dismissed".
  status     String?
  adminNote  String?
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([rating, createdAt])
  @@index([status, createdAt])
}

/// A server-side failure worth an operator's attention. Written from the Next
/// `onRequestError` hook and from the provider's failed model calls, then
/// grouped by fingerprint so ten thousand identical failures read as one row
/// with a count.
model ErrorEvent {
  id          String  @id @default(uuid())
  /// sha256 of (source + message head), the grouping key.
  fingerprint String  @unique
  source      String  @default("server")
  message     String  @db.Text
  stack       String? @db.Text
  path        String? @db.VarChar(512)
  method      String?
  /// "quota" | "timeout" | "safety" | ... for model errors; HTTP status text otherwise.
  kind        String?
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  /// Anything else useful, redacted of secrets before it is written.
  context     Json?

  count      Int       @default(1)
  firstSeen  DateTime  @default(now())
  lastSeen   DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([resolvedAt, lastSeen])
  @@index([source, lastSeen])
}

/// Who did what in the back office. Append-only.
model AdminAuditLog {
  id         String  @id @default(uuid())
  adminId    String
  adminEmail String?
  /// "user.block", "credits.adjust", "setting.update", "model.upsert", ...
  action     String
  targetType String?
  targetId   String?
  /// What changed, minus secrets.
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([adminId, createdAt])
}
