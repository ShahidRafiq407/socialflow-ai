generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  name             String?
  avatar           String?
  stripeCustomerId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  workspaces       Workspace[]
}

model Workspace {
  id              String            @id @default(uuid())
  name            String
  industry        String?
  website         String?
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  brandDNA        BrandDNA?
  socialAccounts  SocialAccount[]
  competitors     Competitor[]
  chatSessions    ChatSession[]
  automationRules AutomationRule[]
  contentPosts    ContentPost[]
  posts           Post[]
  mediaAssets     MediaAsset[]
  hashtagGroups   HashtagGroup[]
  memories        Memory[]
  chatSettings    ChatSettings?
  growthGoal      GrowthGoal?
  wordpressSite   WordPressSite?
  connections     UserConnection[]
  mcpServers      McpServerConnection[]
  trackedLinks    TrackedLink[]
  linkClicks      LinkClick[]
  leadEvents      LeadEvent[]
  publishLogs     PublishLog[]
  articleRuns     ArticleRun[]
  publications    PublishResult[]
  performance     PerformanceData[]
  optimizations   OptimizationRun[]

  // Website lead-capture tag (one site per workspace)
  trackingKey        String?   @unique
  trackingDomain     String?
  trackingVerifiedAt DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
}

model BrandDNA {
  id             String    @id @default(uuid())
  tone           String?
  missionVision  String?
  targetAudience String?
  primaryColors  String[]
  forbiddenWords String[]
  writingStyle   String?
  workspaceId    String    @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId])
}

enum Platform {
  INSTAGRAM
  LINKEDIN
  FACEBOOK
  X
  YOUTUBE
  TIKTOK
  PINTEREST
}

model SocialAccount {
  id             String    @id @default(uuid())
  platform       Platform
  accessToken    String    @default("")
  refreshToken   String?
  accountId      String    @default("")
  handle         String    @default("")
  pageName       String?
  avatarUrl      String?
  tokenExpiresAt DateTime?
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, platform])
  @@index([workspaceId])
}

model Competitor {
  id          String    @id @default(uuid())
  name        String
  platform    Platform
  profileUrl  String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model ChatSession {
  id          String    @id @default(uuid())
  title       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  messages    Message[]
  /// Model id the session last ran on, so reopening it restores the same brain.
  model       String?
  pinned      Boolean   @default(false)
  archived    Boolean   @default(false)
  /// Rolling LLM-written summary of everything older than the live window, so a
  /// long session never loses its earlier context when history is truncated.
  summary     String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, archived, updatedAt])
}

enum Role {
  USER
  AGENT
}

model Message {
  id            String      @id @default(uuid())
  role          Role
  content       String      @db.Text
  toolCalls     Json?
  /// Live thought-summary transcript captured from the model while it worked.
  reasoning     String?     @db.Text
  /// User attachments for a USER message: [{ name, type, size, kind, url? }]
  attachments   Json?
  /// Structured results the UI renders as cards: generated media, deep links
  /// into other tabs, published receipts, files. [{ kind, ... }]
  artifacts     Json?
  /// Follow-up prompts offered under an AGENT message.
  suggestions   Json?
  model         String?
  durationMs    Int?
  /// "ok" | "error" | "cancelled"
  finishReason  String?
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([chatSessionId])
  @@index([chatSessionId, createdAt])
}

model Memory {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  category    String    @default("general")
  content     String    @db.Text
  /// 1 (trivia) … 5 (never forget). Pinned + high-importance facts are always
  /// injected into the controller's context regardless of semantic similarity.
  importance  Int       @default(3)
  /// User-pinned facts survive every prune and always load.
  pinned      Boolean   @default(false)
  /// "auto" (extracted from a conversation) | "user" (explicitly told to remember)
  source      String    @default("auto")
  /// Chat session the fact was learned in, for provenance in the memory browser.
  sessionId   String?
  /// Bumped every time the fact is recalled, so hot memories rank higher.
  hitCount    Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([category])
  @@index([workspaceId, pinned])
}

/// Everything the Automate/Chat controller lets a user tune, per workspace.
/// One row per workspace, created lazily on first read.
model ChatSettings {
  id          String    @id @default(uuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // --- Brain ---
  model            String  @default("gemini-3.1-pro-preview")
  temperature      Float   @default(0.4)
  maxToolLoops     Int     @default(8)
  /// "off" | "concise" | "balanced" | "deep"
  thinkingLevel    String  @default("balanced")
  /// "live" | "collapsed" | "hidden" — how thought summaries are displayed.
  thinkingDisplay  String  @default("live")
  streamTokens     Boolean @default(true)

  // --- Voice ---
  /// "auto" | "english" | "roman-urdu" | "urdu"
  replyLanguage    String  @default("auto")
  /// "executive" | "detailed" | "concise"
  replyStyle       String  @default("executive")
  /// Extra always-on instructions the user writes for the controller.
  customInstructions String? @db.Text

  // --- Autonomy ---
  /// "auto" runs write actions immediately; "confirm" asks first for
  /// publish/delete/push-class actions.
  autonomy         String  @default("auto")
  allowWebSearch   Boolean @default(true)
  allowMediaGen    Boolean @default(true)
  allowPublishing  Boolean @default(true)
  allowPlugins     Boolean @default(true)

  // --- Memory ---
  memoryEnabled    Boolean @default(true)
  memoryAutoSave   Boolean @default(true)
  memoryRecallTopK Int     @default(8)

  // --- Surface ---
  /// "all" | "compact" | "failures" — how much of the tool timeline shows.
  toolVisibility   String  @default("all")
  /// Auto-navigate to the target tab when the controller produces a deep link.
  autoOpenLinks    Boolean @default(false)
  showSuggestions  Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

enum Frequency {
  DAILY
  WEEKLY
  CUSTOM
}

model AutomationRule {
  id                String        @id @default(uuid())
  promptContext     String        @db.Text
  frequency         Frequency
  scheduledTime     String
  platformOverrides String[]
  isActive          Boolean       @default(true)
  workspaceId       String
  workspace         Workspace     @relation(fields: [workspaceId], references: [id])
  contentPosts      ContentPost[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([workspaceId])
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  REJECTED
}

model ContentPost {
  id               String          @id @default(uuid())
  title            String
  body             String          @db.Text
  imageUrl         String?
  videoUrl         String?
  platform         Platform
  status           PostStatus      @default(DRAFT)
  scheduledFor     DateTime?
  publishedAt      DateTime?
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id])
  automationRuleId String?
  automationRule   AutomationRule? @relation(fields: [automationRuleId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId])
  @@index([automationRuleId])
}

model Post {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  platform       String
  content        String    @db.Text
  imageUrl       String?
  imagePrompt    String?   @db.Text
  format         String?
  hashtags       String[]
  mediaType      String?
  mediaSource    String?
  source         String?
  status         String    @default("PENDING_APPROVAL")
  publishError   String?   @db.Text
  agentLogs      Json?
  campaignTopic  String?
  campaignHook   String?
  captionHistory Json?
  mediaHistory   Json?
  publishedAt    DateTime?
  scheduledFor   DateTime?
  settings       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId])
}

model MediaAsset {
  id          String    @id @default(uuid())
  url         String
  filename    String
  contentType String?
  size        Int?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model HashtagGroup {
  id          String    @id @default(uuid())
  name        String
  tags        String[]
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model GrowthGoal {
  id                   String       @id @default(uuid())
  workspaceId          String       @unique
  workspace            Workspace    @relation(fields: [workspaceId], references: [id])
  leadTarget           Int
  leadType             String       @default("QUALIFIED_LEADS")
  customLeadTypeName   String?
  timeframeDays        Int
  startDate            DateTime     @default(now())
  targetPlatforms      String[]     @default([])
  pausedPlatforms      String[]     @default([])

  // Where leads are expected from: "SOCIAL" and/or "WEBSITE"
  leadSources          String[]     @default(["SOCIAL"])
  // Per-platform real CTA destinations, e.g. { "default": "https://…", "linkedin": "https://…" }
  ctaDestinations      Json?
  dailyPostCap         Int?
  articlesPerWeek      Int?
  // Minutes an autopilot post waits before going live, so the user can still delete it
  graceMinutes         Int          @default(15)
  lastPlanRunAt        DateTime?
  lastPlanError        String?      @db.Text

  status               String       @default("INSUFFICIENT_DATA")
  statusReason         String?      @db.Text
  autopilotMode        String       @default("AUTOPILOT")
  autopilotPermissions Json?
  isAutopilotPaused    Boolean      @default(false)
  isPublishingPaused   Boolean      @default(false)
  strategy             Json?
  decisions            Json?
  experiments          Json?
  metricSnapshots      Json?
  lastAuditedAt        DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// LEAD MEASUREMENT — real, measured data only
// ---------------------------------------------------------------------------

/// One short link per AI-generated post/article CTA. Clicks that arrive through
/// it are real clicks from social media, not estimates.
model TrackedLink {
  id          String      @id @default(uuid())
  code        String      @unique
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  postId      String?
  goalId      String?
  channel     String      @default("SOCIAL")
  platform    String
  destination String
  pillar      String?
  clickCount  Int         @default(0)
  leadCount   Int         @default(0)
  clicks      LinkClick[]
  leads       LeadEvent[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([workspaceId])
  @@index([postId])
}

model LinkClick {
  id            String      @id @default(uuid())
  trackedLinkId String
  trackedLink   TrackedLink @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id])
  platform      String
  referrer      String?
  country       String?
  device        String?
  /// sha256(ip + salt) — used only to flag repeat clicks, no raw IP stored
  ipHash        String?
  isUnique      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([trackedLinkId])
  @@index([workspaceId, createdAt])
}

model LeadEvent {
  id            String       @id @default(uuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  trackedLinkId String?
  trackedLink   TrackedLink? @relation(fields: [trackedLinkId], references: [id])
  postId        String?
  platform      String?
  /// MANUAL | WEBSITE_TAG | LINK_CLICK_CONFIRMED
  source        String       @default("MANUAL")
  /// SOCIAL | WEBSITE
  channel       String       @default("SOCIAL")
  /// form_submit | whatsapp | mailto | tel | custom
  action        String?
  leadType      String       @default("QUALIFIED_LEADS")
  contactName   String?
  contactInfo   String?
  value         Float?
  note          String?      @db.Text
  /// NEW | CONFIRMED | QUALIFIED | WON | LOST
  status        String       @default("CONFIRMED")
  occurredAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([workspaceId, occurredAt])
  @@index([postId])
}

/// Slim permanent publish receipt. Heavy Post rows are purged after 3 days but
/// this row (and its live link) is kept, so history never disappears.
model PublishLog {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  postId        String?
  goalId        String?
  trackedLinkId String?
  /// SOCIAL | WEBSITE
  channel       String    @default("SOCIAL")
  platform      String
  format        String?
  /// PUBLISHED | FAILED
  status        String
  liveUrl       String?
  mediaUrl      String?
  mediaType     String?
  excerpt       String    @db.VarChar(240)
  topic         String?
  keyword       String?
  error         String?   @db.Text
  publishedAt   DateTime  @default(now())

  @@index([workspaceId, publishedAt])
  @@index([postId])
}

model WordPressSite {
  id                String    @id @default(uuid())
  workspaceId       String    @unique
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  siteUrl           String
  username          String
  /// Encrypted when APP_ENCRYPTION_KEY is set. Never returned to the client.
  appPassword       String
  defaultStatus     String    @default("publish")
  defaultCategoryId Int?
  defaultAuthorId   Int?
  postType          String    @default("posts")
  enableYoastSeo    Boolean   @default(true)
  lastVerifiedAt    DateTime?
  lastError         String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
}

// Generic external connector credentials (GitHub, HeyGen, Canva, MCP servers,
// ...). Credentials are stored as an encrypted JSON blob (APP_ENCRYPTION_KEY)
// and never sent to the browser — reads only report `hasCredentials`.
model UserConnection {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  providerKey    String
  authType       String    @default("api_key")
  /// Encrypted JSON credentials map. Never returned to the client.
  credentials    String?   @db.Text
  accountLabel   String?
  status         String    @default("pending")
  lastVerifiedAt DateTime?
  lastError      String?   @db.Text
  meta           Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, providerKey])
  @@index([workspaceId])
}

// User-added external MCP (Model Context Protocol) servers. The URL plus any
// auth headers are stored (headers encrypted with APP_ENCRYPTION_KEY) and the
// discovered tool list is cached so chat requests stay fast. Connections are
// opened per request (serverless-friendly Streamable HTTP).
model McpServerConnection {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  name           String
  url            String
  /// Encrypted JSON header map when APP_ENCRYPTION_KEY is set.
  headers        String?   @db.Text
  enabled        Boolean   @default(true)
  /// Snapshot of tools discovered at the last successful verify:
  /// { tools: [{ name, description, inputSchema }], discoveredAt }
  toolCache      Json?
  lastVerifiedAt DateTime?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ===========================================================================
// ARTICLE PIPELINE
//
// One article is one ArticleRun advanced a stage at a time, because the platform
// kills a function at 300s and twenty-three stages do not fit in one request.
// Each stage is its own row: what it produced, how long it took, and — when it
// failed — the named reason. The screen reads these rows, so it can only ever
// show work that actually happened.
// ===========================================================================

model ArticleRun {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  /// quick (12 stages) | deep (23). Chosen per run, never derived from the plan.
  mode        String    @default("quick")
  /// idle | running | blocked | done | failed
  status      String    @default("idle")
  /// The stage key from src/lib/article/stages.ts that runs next.
  currentStage String   @default("business")

  /// The brief: keyword, title, market, language, length, toggles.
  brief       Json
  /// Inputs accumulated by earlier stages and read by later ones.
  state       Json?
  /// quality, differentiation, trust, relevance. Absent until `score` runs.
  scores      Json?

  /// Set when a stage blocks the run (evidence gate, publish gate).
  blockedBy    String?
  /// The blocker's own words. Never a generic "SEO failed".
  blockedReason String? @db.Text

  startedAt      DateTime?
  stageStartedAt DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stages   ArticleStage[]
  sources  ResearchSource[]
  claims   EvidenceClaim[]
  publications PublishResult[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

model ArticleStage {
  id     String     @id @default(uuid())
  runId  String
  run    ArticleRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Stage key from src/lib/article/stages.ts.
  stage  String
  /// Its 1-based position in this run's list, so the UI can order without a join.
  order  Int
  /// pending | running | done | blocked | failed | skipped
  status String     @default("pending")

  /// What the stage produced. The shape is the stage's contract in the plan.
  artifact Json?
  /// Why it failed or blocked, in the words the user should read.
  error    String?  @db.Text
  /// Model calls this stage spent, for the cost the user is shown.
  modelCalls Int    @default(0)
  durationMs Int?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([runId, stage])
  @@index([runId, order])
}

// A source the research stage found. Kept as a row because a claim's provenance
// has to survive the run: months later the question is "where did this come
// from", and a JSON blob inside an artifact cannot answer it.
model ResearchSource {
  id     String     @id @default(uuid())
  runId  String
  run    ArticleRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  url       String  @db.Text
  title     String? @db.Text
  publisher String?
  /// The date the source itself carries, not the date we fetched it.
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  /// The passage the claim rests on, quoted, so a human can check it.
  excerpt     String?   @db.Text
  /// primary | official | journalism | vendor | forum | unknown
  sourceType  String    @default("unknown")
  /// 200-level fetch, or the reason it could not be read.
  reachable   Boolean   @default(false)
  fetchError  String?   @db.Text

  claims EvidenceClaim[]

  @@index([runId])
}

// One factual claim the article wants to make, and the five checks it has to
// pass. `status` is what the writer reads: a blocked claim is never handed to it.
model EvidenceClaim {
  id       String          @id @default(uuid())
  runId    String
  run      ArticleRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId String?
  source   ResearchSource? @relation(fields: [sourceId], references: [id])

  /// The claim as the article would state it.
  claim  String @db.Text
  /// statistic | fact | quote | recommendation | business_fact
  kind   String @default("fact")

  /// The five checks, each true only when it was actually performed and passed.
  sourceExists   Boolean @default(false)
  sourceReachable Boolean @default(false)
  /// The source says this, not merely something adjacent to it.
  sourceSupports Boolean @default(false)
  /// Recent enough for a claim of this kind.
  current        Boolean @default(false)
  trustworthy    Boolean @default(false)

  /// allowed | blocked
  status  String  @default("blocked")
  /// Which check failed, in words: "the 2019 figure is too old to state as current".
  reason  String? @db.Text
  /// Where the claim ended up in the draft, once the writer used it.
  usedIn  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId, status])
  @@index([sourceId])
}

// ===========================================================================
// AFTER PUBLISHING: SEARCH CONSOLE AND THE OPTIMISATION LOOP
//
// Most tools stop at "published". These three tables are what happens next:
// the URL an article became, what Search Console says that URL is being found
// for, and the proposals that come out of the gap between the two.
//
// Nothing here touches a live page. An optimisation is a row a person reads and
// approves; the draft it produces goes back through the editor and the fact
// check before anybody publishes it again.
// ===========================================================================

// One published article at one URL. The row the whole phase hangs off, because
// Search Console reports per page and this is the only place that records which
// page an article became.
model PublishResult {
  id          String      @id @default(uuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  /// The run that produced it, when a run did. Kept nullable so deleting a run's
  /// history does not erase the fact that a page is live.
  runId       String?
  run         ArticleRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  /// The UserConnection id of the CMS target, and which platform it was.
  targetId    String?
  providerKey String?
  /// Scheme + host + path only, lowercased host, no query and no fragment — the
  /// same normalisation Search Console reports pages under, so the two join.
  url         String   @db.VarChar(512)
  /// The platform's own id for the post, so a later update goes to the same one.
  remoteId    String?
  title       String   @db.Text
  /// The keyword it was written for. A query that is *not* this is the signal the
  /// optimisation loop looks for.
  keyword     String?
  /// publish | draft | pending, as the platform accepted it.
  status      String   @default("publish")

  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  optimizations OptimizationRun[]

  @@unique([workspaceId, url])
  @@index([workspaceId, publishedAt])
  @@index([runId])
}

// One day of Search Console data for one query on one page. Rows rather than a
// blob because the question that matters is "which query started sending
// traffic, and when" — that is a sort, not a scan of JSON.
//
// Joined to PublishResult by URL rather than by a foreign key: the data is worth
// keeping for a page we did not publish, and worth keeping after a publication
// row is gone.
model PerformanceData {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  /// The page as Search Console reports it, normalised the same way as above.
  page  String   @db.VarChar(512)
  /// What a person actually typed into Google.
  query String   @db.VarChar(300)
  date  DateTime @db.Date

  impressions Int   @default(0)
  clicks      Int   @default(0)
  /// As Search Console reports them — a 0..1 ratio and an average position, not
  /// recomputed here, so this screen cannot disagree with the console itself.
  ctr      Float @default(0)
  position Float @default(0)

  fetchedAt DateTime @default(now())

  @@unique([workspaceId, page, query, date])
  @@index([workspaceId, page, date])
  @@index([workspaceId, date])
}

// A proposal to update a published article, raised because it is being found for
// something it does not answer. `status` never reaches "applied" on its own:
// applying is a person pressing a button, and this row records that it was.
model OptimizationRun {
  id            String        @id @default(uuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  publicationId String
  publication   PublishResult @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  /// proposed | verified | applied | dismissed | failed
  status String @default("proposed")

  /// The queries that raised it, with their numbers as of that day, so a proposal
  /// read a month later still says what it was reacting to.
  triggers Json
  /// What it proposes: sections to add or passages to change, each with the
  /// queries it answers. Guarded before it is stored, like every artifact.
  proposal Json?
  /// The run that carried research and the evidence gate for this proposal — the
  /// same two stages the first draft passed, so an added section's ledger is as
  /// openable as the article's.
  verifyRunId String?
  /// Why it was dismissed, or why verification refused it. Its own words.
  note String? @db.Text

  raisedAt   DateTime  @default(now())
  verifiedAt DateTime?
  appliedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([publicationId, raisedAt])
}

// ===========================================================================
// SYSTEM NOTICES — THE ONE THING IN THE APP THAT IS NOT PER WORKSPACE
//
// Everything else a user sees is scoped to a workspace. This is not: it is what
// the people running the product say to everyone — maintenance windows, a
// platform API that changed under us, a feature that is live.
//
// Deliberately standalone. No relation to User or Workspace, because a notice is
// not owned by an account and must not disappear when one is deleted, and
// because "read" is a timestamp the browser keeps rather than a row per user per
// notice.
// ===========================================================================

model SystemNotice {
  id String @id @default(uuid())

  /// info | success | warning | error — the same four tones the bell already
  /// renders, so a notice needs no special icon path.
  tone  String  @default("info")
  title String  @db.VarChar(200)
  body  String? @db.Text

  /// Optional "read more": an internal path or an absolute URL. The bell decides
  /// which by looking at the value, exactly as it does for workspace alerts.
  href      String? @db.VarChar(512)
  linkLabel String? @db.VarChar(80)

  /// ALL for now. The column exists so a future targeted broadcast — one plan,
  /// one region — does not need a schema change to land.
  audience String @default("ALL")

  /// Off by default: a notice is written, read back, then published. Unpublishing
  /// is how a notice is retracted, so nothing is ever deleted to hide it.
  published Boolean @default(false)

  /// The window it is shown in. A null endsAt means "until it is unpublished",
  /// which is the right default for anything that is not a maintenance slot.
  startsAt DateTime  @default(now())
  endsAt   DateTime?

  /// Clerk user id of whoever published it. Accountability, not authorisation —
  /// who may publish is decided by the allowlist, not by this column.
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, startsAt])
}


